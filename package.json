{
  "name": "anatole-platform",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "lint:web": "pnpm --dir apps/web lint",
    "typecheck:web": "pnpm --dir apps/web typecheck",
    "test:api": "python -m pytest apps/api/tests -q",
    "test:e2e": "playwright test",
    "quality": "pnpm test:api && pnpm typecheck:web && pnpm build:web && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.0"
  }
}
